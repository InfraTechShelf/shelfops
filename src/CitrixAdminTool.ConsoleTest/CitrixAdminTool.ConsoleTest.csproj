<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <ProjectGuid>{7C1E4A20-0002-4B3D-9A11-C1741AD10002}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>CitrixAdminTool.ConsoleTest</RootNamespace>
    <AssemblyName>ShelfOps.ConsoleTest</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!--
      AnyCPU（32bit優先を無効）にする。Windows PowerShell 5.1 の
      System.Management.Automation はMSILなのでビット数を問わないが、
      64bitプロセスで動かした方がCitrix SDK側の想定に沿う。
    -->
    <Prefer32Bit>false</Prefer32Bit>
    <!--
      【必須要件】UAC昇格マニフェストを付けない。
      標準ユーザー権限のまま起動できることが受け入れ基準のひとつ。
    -->
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(SolutionRootDir)dist\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(SolutionRootDir)dist\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TeeWriter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CitrixAdminTool.Core\CitrixAdminTool.Core.csproj">
      <Project>{7C1E4A20-0001-4B3D-9A11-C1741AD10001}</Project>
      <Name>CitrixAdminTool.Core</Name>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
