<Window x:Class="CitrixAdminTool.Wpf.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CitrixAdminTool.Wpf.Services.Localization"
        Title="{loc:T About_Title}"
        Height="420" Width="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="ShelfOps" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="#8A6D1F" CornerRadius="3" Padding="6,2" Margin="10,4,0,0"
                    VerticalAlignment="Center">
                <TextBlock Text="ALPHA" Foreground="White" FontSize="11" FontWeight="Bold" />
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="VersionText" Foreground="#555555" Margin="0,4,0,12" />

        <StackPanel Grid.Row="2">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{loc:T About_Description}" />

            <TextBlock TextWrapping="Wrap" Foreground="#8A6D1F" Margin="0,0,0,10"
                       Text="{loc:T About_AlphaWarning}" />

            <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="11"
                       Text="{loc:T About_Trademark}" />

            <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="11" Margin="0,8,0,0"
                       Text="{loc:T About_License}" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CopyrightText" DockPanel.Dock="Left" Foreground="#888888"
                       FontSize="11" VerticalAlignment="Center" />
            <Button Content="{loc:T Common_Close}" IsDefault="True" IsCancel="True" Click="OnClose"
                    HorizontalAlignment="Right" MinWidth="88" />
        </DockPanel>
    </Grid>
</Window>
