<Window x:Class="CitrixAdminTool.Wpf.Views.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CitrixAdminTool.Wpf.Services.Localization"
        Title="{loc:T Cred_Title}"
        Height="272" Width="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.ColumnSpan="2"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Cred_Domain}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DomainBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Cred_UserName}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UserNameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Cred_Password}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                     Padding="4,3" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"
                   Foreground="#666666" FontSize="11"
                   Text="{loc:T Cred_Hint}" />

        <TextBlock x:Name="ErrorText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"
                   Foreground="#C0392B" FontSize="11" VerticalAlignment="Bottom"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T Common_Connect}" IsDefault="True" Click="OnOkClick" />
            <Button Content="{loc:T Common_Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
