<Window x:Class="CitrixAdminTool.Wpf.Views.DesktopGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CitrixAdminTool.Wpf.Services.Localization"
        Title="{Binding Title}"
        Height="600" Width="1100" MinHeight="400" MinWidth="820"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <loc:SessionSupportConverter x:Key="SessionSupportConv" />

        <!-- メンテナンスONを目立たせる（マシン一覧と同じ表現） -->
        <Style x:Key="MaintenanceCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#999999" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding InMaintenanceMode}" Value="True">
                    <Setter Property="Foreground" Value="#C00000" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 無効なグループは薄く。有効／無効は運用上まず見る項目 -->
        <Style x:Key="EnabledCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="#C00000" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 未登録マシンが 0 でなければ赤字。VDA が DDC に登録できていないマシンがある -->
        <Style x:Key="UnregisteredCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#C00000" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DesktopsUnregistered}" Value="0">
                    <Setter Property="Foreground" Value="#999999" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ツールバー2段（上段=操作 / 下段=絞り込み）。0.9 で上段に「設定を保存」等が加わる -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:T Common_Refresh}" Command="{Binding RefreshCommand}" MinWidth="72" />
                    <Border Width="1" Background="#CCCCCC" Margin="6,2,10,2" />
                    <Button Content="{loc:T Common_CopyForExcel}" Click="OnCopyToClipboard" MinWidth="112"
                            IsEnabled="{Binding IsNotBusy}" ToolTip="{loc:T Export_TipClipboard}" />
                    <Button Content="{loc:T Common_SaveCsv}" Click="OnExportCsv" MinWidth="96" Margin="6,0,0,0"
                            IsEnabled="{Binding IsNotBusy}" ToolTip="{loc:T Export_TipCsv}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{loc:T Dg_LabelKind}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="120" VerticalContentAlignment="Center" Margin="0,0,10,0"
                              ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindFilter}"
                              ToolTip="{loc:T Dg_TipKind}" />
                    <TextBlock Text="{loc:T Dg_LabelDelivery}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="170" VerticalContentAlignment="Center" Margin="0,0,10,0"
                              ItemsSource="{Binding DeliveryTypes}" SelectedItem="{Binding DeliveryFilter}"
                              ToolTip="{loc:T Dg_TipDelivery}" />
                    <TextBlock Text="{loc:T Dg_LabelEnabled}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="110" VerticalContentAlignment="Center" Margin="0,0,10,0"
                              ItemsSource="{Binding EnabledStates}" SelectedItem="{Binding EnabledFilter}" />
                    <TextBlock Text="{loc:T Common_LabelSearch}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Width="180" VerticalContentAlignment="Center" Padding="4,3"
                             Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:T Dg_TipSearch}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="12" IsIndeterminate="True" Margin="8,0,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FilterSummary}" Foreground="#555555" Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="GroupGrid" Margin="10"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ClipboardCopyMode="IncludeHeader"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  IsEnabled="{Binding IsNotBusy}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:T Common_CopyForExcel}" Click="OnCopyToClipboard" />
                    <MenuItem Header="{loc:T Common_SaveCsv}" Click="OnExportCsv" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T Dg_ColName}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{loc:T Dg_ColEnabled}" Binding="{Binding Enabled}" Width="Auto"
                                    ElementStyle="{StaticResource EnabledCell}" />
                <DataGridTextColumn Header="{loc:T Col_Maint}" Binding="{Binding MaintenanceLabel}" Width="60"
                                    ElementStyle="{StaticResource MaintenanceCell}" />
                <DataGridTextColumn Header="{loc:T Dg_ColKind}" Binding="{Binding DesktopKind}" Width="Auto" />
                <DataGridTextColumn Header="{loc:T Dg_ColDelivery}" Binding="{Binding DeliveryType}" Width="Auto" />
                <DataGridTextColumn Header="{loc:T Col_Type}"
                                    Binding="{Binding SessionSupport, Converter={StaticResource SessionSupportConv}}" Width="Auto" />
                <DataGridTextColumn Header="{loc:T Dg_ColTotal}" Binding="{Binding TotalDesktops}" Width="Auto"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="{loc:T Dg_ColInUse}" Binding="{Binding DesktopsInUse}" Width="Auto"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="{loc:T Dg_ColUnregistered}" Binding="{Binding DesktopsUnregistered}" Width="Auto"
                                    ElementStyle="{StaticResource UnregisteredCell}" />
                <DataGridTextColumn Header="{loc:T Col_SessionCount}" Binding="{Binding Sessions}" Width="Auto"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="{loc:T Dg_ColDescription}" Binding="{Binding Description}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Description}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
