<Window x:Class="CitrixAdminTool.Wpf.Views.SnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CitrixAdminTool.Wpf.Services.Localization"
        Title="{Binding Title}"
        Height="640" Width="1100" MinHeight="400" MinWidth="760"
        WindowStartupLocation="CenterOwner">

    <DockPanel>

        <!-- 上段: 操作 / 下段: 絞り込み -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:T Snap_SaveFile}" Click="OnSave" MinWidth="120"
                            ToolTip="{loc:T Snap_TipSaveFile}" />
                    <Button Content="{loc:T Snap_CompareFile}" Click="OnCompare" MinWidth="150" Margin="6,0,0,0"
                            ToolTip="{loc:T Snap_TipCompareFile}" />
                    <Border Width="1" Background="#CCCCCC" Margin="10,2,10,2" />
                    <Button Content="{loc:T Common_CopyForExcel}" Click="OnCopy" MinWidth="112"
                            ToolTip="{loc:T Export_TipClipboard}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{loc:T Snap_LabelSection}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="220" VerticalContentAlignment="Center" Margin="0,0,10,0"
                              ItemsSource="{Binding SectionFilters}" SelectedItem="{Binding SectionFilter}" />
                    <TextBlock Text="{loc:T Common_LabelSearch}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Width="240" VerticalContentAlignment="Center" Padding="4,3"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:T Snap_TipSearch}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 要約。取得できなかった区分があれば赤字で目立たせる -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                    <Setter Property="Foreground" Value="#C00000" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{loc:T Snap_ExcludedHint}" Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FilterSummary}" Foreground="#555555" Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="RowGrid" Margin="10"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ClipboardCopyMode="IncludeHeader"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- 稼働状況など比較対象外の値は灰色。設定値と見分けられるように -->
                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                            <Setter Property="Foreground" Value="#999999" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Foreground" Value="#C00000" />
                            <Setter Property="Background" Value="#FFF4F4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T Snap_ColSection}" Binding="{Binding SectionLabel}" Width="Auto" />
                <DataGridTextColumn Header="{loc:T Snap_ColItem}" Binding="{Binding ItemName}" Width="*" />
                <DataGridTextColumn Header="{loc:T Snap_ColProperty}" Binding="{Binding Property}" Width="*" />
                <DataGridTextColumn Header="{loc:T Snap_ColValue}" Binding="{Binding Value}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Value}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
