<Window x:Class="CitrixAdminTool.Wpf.Views.OperationDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CitrixAdminTool.Wpf.Services.Localization"
        Title="{loc:T Detail_Title}"
        Height="440" Width="720" MinHeight="260" MinWidth="480"
        WindowStartupLocation="CenterOwner">

    <DockPanel>

        <!-- 集計 -->
        <Border DockPanel.Dock="Top" Padding="12,10" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="Bold" />
        </Border>

        <!-- 操作ボタン -->
        <Border DockPanel.Dock="Bottom" Padding="12,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Foreground="#666666" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{loc:T Detail_LogNote}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T Detail_CopyList}" Click="OnCopy" MinWidth="104" Margin="0,0,8,0"
                            ToolTip="{loc:T Detail_TipCopy}" />
                    <Button Content="{loc:T Common_Close}" IsDefault="True" IsCancel="True" Click="OnClose" MinWidth="88" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 明細。失敗を上に並べ、赤字にして即座に見つけられるようにする -->
        <DataGrid x:Name="TargetGrid" Margin="12,10"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  ClipboardCopyMode="IncludeHeader"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Success}" Value="False">
                            <Setter Property="Foreground" Value="#C00000" />
                            <Setter Property="Background" Value="#FFF4F4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T Detail_ColResult}" Binding="{Binding ResultLabel}" Width="Auto" />
                <DataGridTextColumn Header="{loc:T Detail_ColTarget}" Binding="{Binding TargetName}" Width="2*" />
                <DataGridTextColumn Header="{loc:T Detail_ColReason}" Binding="{Binding ErrorMessage}" Width="3*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
