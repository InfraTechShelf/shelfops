    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />

    <!--
      Windows PowerShell 5.1 のホスティング用アセンブリ。

      仕様書は NuGet の Microsoft.PowerShell.5.1.ReferenceAssemblies を想定していたが、
      System.Management.Automation.dll は Windows PowerShell 5.1 に同梱され GAC に
      常駐しているため、NuGet を使わずに直接参照できる。

      Private=false（コピーローカルしない）が重要:
        - これは Windows のシステムコンポーネントであり、PowerShell 5.1 が入っている
          すべての Windows（= CVAD管理環境を含む）に必ず存在する。
        - 出力フォルダへコピーするとバージョン不一致や型の同一性の問題を招く。
      したがって「単一フォルダ自己完結」の要件はこの参照によって損なわれない。
    -->
    <Reference Include="System.Management.Automation">
      <HintPath>$(WinDir)\Microsoft.NET\assembly\GAC_MSIL\System.Management.Automation\v4.0_3.0.0.0__31bf3856ad364e35\System.Management.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

